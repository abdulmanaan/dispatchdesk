# Copy to .env for running the backend directly on your machine (outside Docker).
ENVIRONMENT=development
DEBUG=true
# Frontend origins allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://dispatchdesk:dispatchdesk@localhost:5433/dispatchdesk
# Neon example (plain URLs from the Neon console work, they are normalized automatically):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dispatchdesk?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis for caching and rate limiting (optional: leave empty to disable both).
REDIS_URL=redis://localhost:6379/0
# Upstash example: REDIS_URL=rediss://default:password@xxx.upstash.io:6379

# Background jobs
ACCEPTANCE_TIMEOUT_SECONDS=180
# Enables POST /internal/jobs/run for an external scheduler (production).
# JOBS_TOKEN=change-me
